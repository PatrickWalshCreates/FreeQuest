{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 7
    },
    "attackSkill": {
      "type": "string",
      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "battleMusic": {
          "type": "string",
          "description": "Path relative to the project root, using \"/\" separators.",
          "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
        },
        "gameOverMusic": {
          "type": "string",
          "description": "Path relative to the project root, using \"/\" separators.",
          "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
        },
        "sounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "battleStart": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            },
            "buzzer": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            },
            "cancel": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            },
            "confirm": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            },
            "cursor": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            },
            "damage": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            },
            "heal": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            },
            "save": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            },
            "turnStart": {
              "type": "string",
              "description": "Path relative to the project root, using \"/\" separators.",
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
            }
          }
        },
        "titleMusic": {
          "type": "string",
          "description": "Path relative to the project root, using \"/\" separators.",
          "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
        },
        "victoryMusic": {
          "type": "string",
          "description": "Path relative to the project root, using \"/\" separators.",
          "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
        }
      }
    },
    "balloons": {
      "type": "object",
      "additionalProperties": false,
      "description": "Balloons over characters (v5): an image with one balloon per row, each `frames` square frames of `size` pixels, played left to right.",
      "properties": {
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "string",
          "description": "Path relative to the project root, using \"/\" separators.",
          "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
        },
        "names": {
          "type": "array",
          "description": "One per row of the image, top first.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["image", "size", "frames", "names"]
    },
    "battleBackground": {
      "type": "string",
      "description": "Path relative to the project root, using \"/\" separators.",
      "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
    },
    "currency": {
      "type": "string",
      "description": "Shown after gold amounts, e.g. \"G\".",
      "minLength": 1
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "name"]
      }
    },
    "equipmentSlots": {
      "type": "array",
      "description": "In menu order, e.g. weapon, shield, head.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "name"]
      }
    },
    "equipmentTypes": {
      "type": "array",
      "description": "e.g. sword, staff, light armor.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "name"]
      }
    },
    "guardSkill": {
      "type": "string",
      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "iconset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "iconSize": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "string",
          "description": "Path relative to the project root, using \"/\" separators.",
          "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
        }
      },
      "required": ["image", "iconSize", "columns"]
    },
    "skillTypes": {
      "type": "array",
      "description": "e.g. magic, techniques.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "name"]
      }
    },
    "titleScreen": {
      "type": "object",
      "additionalProperties": false,
      "description": "A picture behind the title screen, scaled to cover the screen (v5).",
      "properties": {
        "image": {
          "type": "string",
          "description": "Path relative to the project root, using \"/\" separators.",
          "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
        },
        "showName": {
          "type": "boolean"
        }
      },
      "required": ["image", "showName"]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the game’s windows look (v7). Anything left out is FreeQuest’s own look.",
      "properties": {
        "borderColor": {
          "type": "string",
          "description": "A colour, #rrggbb.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
          "type": "string",
          "description": "Path relative to the project root, using \"/\" separators.",
          "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
        },
        "fontSize": {
          "type": "integer",
          "maximum": 48,
          "minimum": 6
        },
        "lineHeight": {
          "type": "integer",
          "maximum": 64,
          "minimum": 6
        },
        "padding": {
          "type": "integer",
          "maximum": 32,
          "minimum": 0
        },
        "speakerColor": {
          "type": "string",
          "description": "A colour, #rrggbb.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "textColor": {
          "type": "string",
          "description": "A colour, #rrggbb.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "textColors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blue": {
              "type": "string",
              "description": "A colour, #rrggbb.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "gray": {
              "type": "string",
              "description": "A colour, #rrggbb.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "green": {
              "type": "string",
              "description": "A colour, #rrggbb.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "orange": {
              "type": "string",
              "description": "A colour, #rrggbb.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "purple": {
              "type": "string",
              "description": "A colour, #rrggbb.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "red": {
              "type": "string",
              "description": "A colour, #rrggbb.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "white": {
              "type": "string",
              "description": "A colour, #rrggbb.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "yellow": {
              "type": "string",
              "description": "A colour, #rrggbb.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "windowColor": {
          "type": "string",
          "description": "A colour, #rrggbb.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "windowOpacity": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        }
      }
    }
  },
  "required": ["formatVersion", "currency", "elements", "equipmentSlots", "equipmentTypes", "skillTypes"],
  "title": "FreeQuest system data"
}
