{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "description": "Path relative to the project root, using \"/\" separators.",
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
          }
        },
        "required": ["id", "path"]
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "description": "Path relative to the project root, using \"/\" separators.",
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
          }
        },
        "required": ["id", "path"]
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character": {
          "type": "string",
          "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "speed": {
          "type": "number",
          "description": "Walking speed in tiles per second.",
          "exclusiveMinimum": 0
        }
      },
      "required": ["character", "speed"]
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "description": "Internal render resolution in pixels.",
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["width", "height"]
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the player appears on a new game.",
      "properties": {
        "direction": {
          "anyOf": [
            {
              "type": "string",
              "const": "down"
            },
            {
              "type": "string",
              "const": "left"
            },
            {
              "type": "string",
              "const": "right"
            },
            {
              "type": "string",
              "const": "up"
            }
          ]
        },
        "map": {
          "type": "string",
          "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["map", "x", "y", "direction"]
    },
    "switches": {
      "type": "array",
      "description": "Named on/off flags.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      }
    },
    "tilesets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "description": "Path relative to the project root, using \"/\" separators.",
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
          }
        },
        "required": ["id", "path"]
      }
    },
    "variables": {
      "type": "array",
      "description": "Named integer values.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      }
    }
  },
  "required": ["formatVersion", "name", "screen", "start", "player", "tilesets", "maps", "characters", "switches", "variables"],
  "title": "FreeQuest project manifest"
}
