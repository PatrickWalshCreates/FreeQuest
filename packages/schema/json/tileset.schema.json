{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string"
    },
    "columns": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "string",
      "description": "Path relative to the project root, using \"/\" separators.",
      "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
    },
    "tileHeight": {
      "type": "integer",
      "minimum": 1
    },
    "tileWidth": {
      "type": "integer",
      "minimum": 1
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "above": {
            "type": "boolean",
            "description": "Drawn above characters and ignored for collision (e.g. treetops)."
          },
          "passable": {
            "type": "boolean",
            "description": "Whether characters can walk onto this tile."
          }
        },
        "required": ["passable"]
      },
      "minItems": 1
    }
  },
  "required": ["formatVersion", "id", "name", "image", "tileWidth", "tileHeight", "columns", "tiles"],
  "title": "FreeQuest tileset"
}
