{
  "type": "object",
  "$defs": {
    "Command": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Show a message box and wait for confirm.",
          "properties": {
            "type": {
              "type": "string",
              "const": "message"
            },
            "speaker": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": ["type", "text"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Let the player pick one option.",
          "properties": {
            "type": {
              "type": "string",
              "const": "choice"
            },
            "cancel": {
              "type": "integer",
              "description": "Option index taken when the player cancels. Omit to disallow cancel.",
              "minimum": 0
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commands": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Command"
                    }
                  }
                },
                "required": ["label", "commands"]
              },
              "minItems": 1
            }
          },
          "required": ["type", "options"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "if"
            },
            "conditions": {
              "type": "array",
              "description": "All conditions must hold.",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "switch"
                      },
                      "switch": {
                        "type": "string",
                        "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": ["type", "switch", "value"]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "variable"
                      },
                      "op": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "=="
                          },
                          {
                            "type": "string",
                            "const": "!="
                          },
                          {
                            "type": "string",
                            "const": "<"
                          },
                          {
                            "type": "string",
                            "const": "<="
                          },
                          {
                            "type": "string",
                            "const": ">"
                          },
                          {
                            "type": "string",
                            "const": ">="
                          }
                        ]
                      },
                      "value": {
                        "type": "integer"
                      },
                      "variable": {
                        "type": "string",
                        "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      }
                    },
                    "required": ["type", "variable", "op", "value"]
                  }
                ]
              },
              "minItems": 1
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Command"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Command"
              }
            }
          },
          "required": ["type", "conditions", "then"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "setSwitch"
            },
            "switch": {
              "type": "string",
              "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": ["type", "switch", "value"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "setVariable"
            },
            "op": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "set"
                },
                {
                  "type": "string",
                  "const": "add"
                },
                {
                  "type": "string",
                  "const": "sub"
                },
                {
                  "type": "string",
                  "const": "mul"
                },
                {
                  "type": "string",
                  "const": "div"
                },
                {
                  "type": "string",
                  "const": "mod"
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "variable": {
                      "type": "string",
                      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    }
                  },
                  "required": ["variable"]
                }
              ]
            },
            "variable": {
              "type": "string",
              "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "required": ["type", "variable", "op", "value"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Move the player to another map or tile.",
          "properties": {
            "type": {
              "type": "string",
              "const": "transfer"
            },
            "direction": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "down"
                },
                {
                  "type": "string",
                  "const": "left"
                },
                {
                  "type": "string",
                  "const": "right"
                },
                {
                  "type": "string",
                  "const": "up"
                }
              ]
            },
            "map": {
              "type": "string",
              "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["type", "map", "x", "y"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "wait"
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": ["type", "seconds"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Note for authors. Does nothing.",
          "properties": {
            "type": {
              "type": "string",
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          },
          "required": ["type", "text"]
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string"
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "tileset": {
      "type": "string",
      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "description": "Rows of tile indices, top to bottom. -1 means empty.",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -1
              }
            }
          }
        },
        "required": ["name", "data"]
      },
      "minItems": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "conditions": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "switch"
                          },
                          "switch": {
                            "type": "string",
                            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                            "pattern": "^[a-z0-9][a-z0-9_-]*$"
                          },
                          "value": {
                            "type": "boolean"
                          }
                        },
                        "required": ["type", "switch", "value"]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "variable"
                          },
                          "op": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "=="
                              },
                              {
                                "type": "string",
                                "const": "!="
                              },
                              {
                                "type": "string",
                                "const": "<"
                              },
                              {
                                "type": "string",
                                "const": "<="
                              },
                              {
                                "type": "string",
                                "const": ">"
                              },
                              {
                                "type": "string",
                                "const": ">="
                              }
                            ]
                          },
                          "value": {
                            "type": "integer"
                          },
                          "variable": {
                            "type": "string",
                            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                            "pattern": "^[a-z0-9][a-z0-9_-]*$"
                          }
                        },
                        "required": ["type", "variable", "op", "value"]
                      }
                    ]
                  }
                },
                "graphic": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Omit for an invisible event.",
                  "properties": {
                    "character": {
                      "type": "string",
                      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "direction": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "down"
                        },
                        {
                          "type": "string",
                          "const": "left"
                        },
                        {
                          "type": "string",
                          "const": "right"
                        },
                        {
                          "type": "string",
                          "const": "up"
                        }
                      ]
                    }
                  },
                  "required": ["character", "direction"]
                },
                "layer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "below"
                    },
                    {
                      "type": "string",
                      "const": "same"
                    },
                    {
                      "type": "string",
                      "const": "above"
                    }
                  ],
                  "description": "Drawn below, level with, or above characters. Only \"same\" blocks movement."
                },
                "trigger": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "action"
                    },
                    {
                      "type": "string",
                      "const": "touch"
                    },
                    {
                      "type": "string",
                      "const": "autorun"
                    },
                    {
                      "type": "string",
                      "const": "parallel"
                    }
                  ],
                  "description": "action: player faces it and presses confirm. touch: player steps into or onto it. autorun: runs as soon as the page is active, blocking the player. parallel: runs alongside play."
                },
                "commands": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Command"
                  }
                }
              },
              "required": ["conditions", "trigger", "layer", "commands"]
            },
            "minItems": 1
          }
        },
        "required": ["id", "name", "x", "y", "pages"]
      }
    }
  },
  "required": ["formatVersion", "id", "name", "width", "height", "tileset", "layers", "events"],
  "title": "FreeQuest map"
}
