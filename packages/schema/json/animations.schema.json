{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 6
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fps": {
            "type": "number",
            "description": "Frames per second.",
            "maximum": 60,
            "minimum": 1
          },
          "frameHeight": {
            "type": "integer",
            "minimum": 1
          },
          "frameWidth": {
            "type": "integer",
            "minimum": 1
          },
          "frames": {
            "type": "integer",
            "minimum": 1
          },
          "image": {
            "type": "string",
            "description": "Path relative to the project root, using \"/\" separators.",
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
          },
          "note": {
            "type": "string",
            "description": "For authors; never shown in the game."
          },
          "sounds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string",
                  "description": "Path relative to the project root, using \"/\" separators.",
                  "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*\\\\)[^\\0]+$"
                }
              },
              "required": ["frame", "path"]
            }
          }
        },
        "required": ["id", "name", "frameWidth", "frameHeight", "frames", "fps", "sounds"]
      }
    }
  },
  "required": ["formatVersion", "entries"],
  "title": "FreeQuest animations"
}
