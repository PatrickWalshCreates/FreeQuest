{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "exp": {
            "type": "object",
            "additionalProperties": false,
            "description": "Total exp to reach level L = round(base * (L - 1) ^ exponent).",
            "properties": {
              "base": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "exponent": {
                "type": "number",
                "minimum": 1
              }
            },
            "required": ["base", "exponent"]
          },
          "icon": {
            "type": "integer",
            "minimum": 0
          },
          "modifiers": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "statRate"
                    },
                    "stat": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "maxHp"
                        },
                        {
                          "type": "string",
                          "const": "maxMp"
                        },
                        {
                          "type": "string",
                          "const": "attack"
                        },
                        {
                          "type": "string",
                          "const": "defense"
                        },
                        {
                          "type": "string",
                          "const": "magicAttack"
                        },
                        {
                          "type": "string",
                          "const": "magicDefense"
                        },
                        {
                          "type": "string",
                          "const": "agility"
                        },
                        {
                          "type": "string",
                          "const": "luck"
                        }
                      ]
                    },
                    "value": {
                      "type": "number",
                      "description": "Multiplier, e.g. 1.1 for +10%.",
                      "minimum": 0
                    }
                  },
                  "required": ["type", "stat", "value"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Added to the stat after rates.",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "statFlat"
                    },
                    "stat": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "maxHp"
                        },
                        {
                          "type": "string",
                          "const": "maxMp"
                        },
                        {
                          "type": "string",
                          "const": "attack"
                        },
                        {
                          "type": "string",
                          "const": "defense"
                        },
                        {
                          "type": "string",
                          "const": "magicAttack"
                        },
                        {
                          "type": "string",
                          "const": "magicDefense"
                        },
                        {
                          "type": "string",
                          "const": "agility"
                        },
                        {
                          "type": "string",
                          "const": "luck"
                        }
                      ]
                    },
                    "value": {
                      "type": "integer"
                    }
                  },
                  "required": ["type", "stat", "value"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "elementRate"
                    },
                    "element": {
                      "type": "string",
                      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "value": {
                      "type": "number",
                      "description": "Damage taken multiplier.",
                      "minimum": 0
                    }
                  },
                  "required": ["type", "element", "value"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "stateRate"
                    },
                    "state": {
                      "type": "string",
                      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "value": {
                      "type": "number",
                      "description": "Chance multiplier; 0 = immune.",
                      "minimum": 0
                    }
                  },
                  "required": ["type", "state", "value"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Element of normal attacks.",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "attackElement"
                    },
                    "element": {
                      "type": "string",
                      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    }
                  },
                  "required": ["type", "element"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Allows equipping this equipment type.",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "equipType"
                    },
                    "equipmentType": {
                      "type": "string",
                      "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    }
                  },
                  "required": ["type", "equipmentType"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "hpRegen"
                    },
                    "value": {
                      "type": "number",
                      "description": "Fraction of max HP gained each turn; negative for poison.",
                      "maximum": 1,
                      "minimum": -1
                    }
                  },
                  "required": ["type", "value"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "hitRate"
                        },
                        {
                          "type": "string",
                          "const": "evasionRate"
                        },
                        {
                          "type": "string",
                          "const": "criticalRate"
                        }
                      ]
                    },
                    "value": {
                      "type": "number",
                      "description": "Added to the base chance (hit 0.95, evasion 0.05, critical 0.04).",
                      "maximum": 1,
                      "minimum": -1
                    }
                  },
                  "required": ["type", "value"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "damageTaken"
                    },
                    "value": {
                      "type": "number",
                      "description": "Multiplier on HP damage taken, e.g. 0.5 when guarding.",
                      "minimum": 0
                    }
                  },
                  "required": ["type", "value"]
                }
              ]
            }
          },
          "skills": {
            "type": "array",
            "description": "Skills learned on reaching a level.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1
                },
                "skill": {
                  "type": "string",
                  "description": "Lowercase identifier: letters, digits, \"_\" and \"-\".",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                }
              },
              "required": ["level", "skill"]
            }
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agility": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "patternProperties": {
                  "^-?(?:0|[1-9][0-9]*)$": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "attack": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "patternProperties": {
                  "^-?(?:0|[1-9][0-9]*)$": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "defense": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "patternProperties": {
                  "^-?(?:0|[1-9][0-9]*)$": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "luck": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "patternProperties": {
                  "^-?(?:0|[1-9][0-9]*)$": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "magicAttack": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "patternProperties": {
                  "^-?(?:0|[1-9][0-9]*)$": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "magicDefense": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "patternProperties": {
                  "^-?(?:0|[1-9][0-9]*)$": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "maxHp": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "patternProperties": {
                  "^-?(?:0|[1-9][0-9]*)$": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "maxMp": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "patternProperties": {
                  "^-?(?:0|[1-9][0-9]*)$": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "required": ["maxHp", "maxMp", "attack", "defense", "magicAttack", "magicDefense", "agility", "luck"]
          }
        },
        "required": ["id", "name", "exp", "stats", "skills", "modifiers"]
      }
    }
  },
  "required": ["formatVersion", "entries"],
  "title": "FreeQuest classes"
}
