{
  "name": "freequest-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "FreeQuest: a free, open-source 2D RPG engine and editor.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @freequest/player-web dev",
    "editor": "pnpm --filter @freequest/editor dev",
    "editor:desktop": "pnpm --filter @freequest/editor desktop",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "gen:art": "tsx scripts/gen-placeholder-art.ts",
    "gen:audio": "tsx scripts/gen-placeholder-audio.ts",
    "gen:schema": "pnpm --filter @freequest/schema run gen:schema"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
