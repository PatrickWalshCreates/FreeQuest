{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeQuest Player",
  "version": "0.0.0",
  "identifier": "org.freequest.player",
  "build": {
    "beforeBuildCommand": "pnpm --filter @freequest/player build",
    "frontendDist": "../../../packages/player/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FreeQuest Player",
        "width": 960,
        "height": 704,
        "minWidth": 480,
        "minHeight": 352,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/game/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../../../samples/demo-project/": "game/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
