{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The editor window: open and confirm dialogs, closing with an unsaved-changes check, and read/write inside folders the user picked, and opening web links in the browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "dialog:allow-ask",
    "core:window:allow-destroy",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$RESOURCE/mac-player/**"
        }
      ]
    },
    "core:path:default",
    "opener:default"
  ]
}
