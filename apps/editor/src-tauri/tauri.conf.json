{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeQuest Editor",
  "version": "0.7.0",
  "identifier": "org.freequest.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FreeQuest Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; script-src 'self' tauri://localhost http://tauri.localhost blob:; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "players/": "players/"
    },
    "publisher": "Patrick Walsh",
    "copyright": "Copyright © 2026 Patrick Walsh and FreeQuest contributors. MIT License."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwOUE2NkZEMzA0N0Q4RjUKUldUMTJFY3cvV2FhSUNxRFVzMmtOd0xmeHBzUW1VZ1YzaGVCQWNUL3MzL1ZoUXpWQ3dwUU9LakcK",
      "endpoints": [
        "https://github.com/PatrickWalshCreates/FreeQuest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
